{
	"schemaVersion": 1,
	"id": "codon",
	"version": "${version}",
	"name": "Codon",
	"description": "An in-game step debugger for Minecraft commands and datapack functions: breakpoints, stepping, call stacks, and in-world visualization.",
	"authors": [
		"nutyworks"
	],
	"contact": {
		"homepage": "https://github.com/nutyworks/codon",
		"sources": "https://github.com/nutyworks/codon",
		"issues": "https://github.com/nutyworks/codon/issues"
	},
	"license": "MIT",
	"icon": "assets/codon/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"works.nuty.codon.CodonMod"
		],
		"client": [
			"works.nuty.codon.client.CodonClientMod"
		]
	},
	"accessWidener": "codon.classtweaker",
	"mixins": [
		"codon.mixins.json",
		{
			"config": "codon.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
